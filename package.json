{
  "name": "playwright-summary-ai",
  "version": "0.1.0",
  "description": "CLI tool that summarizes Playwright results and uploads insights to TestRelic.",
  "main": "src/summarize-results.js",
  "type": "commonjs",
  "bin": {
    "test-signal": "./bin/test-signal.py"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:intentional-failure": "RUN_INTENTIONAL_FAILURE=1 npx playwright test tests/playwright.spec.js -g \"intentional failure\"",
    "summary": "node src/summarize-results.js playwright-report.json",
    "summary:python": "python3 -m test_signal analyze --report playwright-report.json --out test-summary-python.txt",
    "analyze": "python3 -m test_signal analyze --report tests/fixtures/playwright-report.json",
    "ci": "npm test && npm run summary && npm run summary:python"
  },
  "keywords": [
    "python",
    "playwright",
    "test",
    "summary",
    "testrelic",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@testrelic/playwright-analytics": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  }
}
