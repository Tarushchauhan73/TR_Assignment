{"url":"file:///workspaces/TR_Assignment/tests/fixtures/demo-app.html","method":"GET","resourceType":"document","statusCode":200,"responseTimeMs":1,"startedAt":"2026-05-25T10:21:21.598Z","requestHeaders":{"accept-language":"en-US","sec-ch-ua":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\"","sec-ch-ua-mobile":"?0","sec-ch-ua-platform":"\"Linux\""},"requestBody":null,"responseBody":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Demo Test App</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 32px; }\n    .hidden { display: none; }\n    .panel { border: 1px solid #ddd; padding: 20px; max-width: 420px; }\n    .success { color: green; }\n    .error { color: red; }\n  </style>\n</head>\n<body>\n  <div class=\"panel\" id=\"login-panel\">\n    <h2>Login</h2>\n    <form id=\"login-form\">\n      <label>Username<br /><input id=\"username\" name=\"username\" /></label><br /><br />\n      <label>Password<br /><input id=\"password\" name=\"password\" type=\"password\" /></label><br /><br />\n      <button type=\"submit\">Login</button>\n      <div id=\"login-message\" role=\"status\"></div>\n    </form>\n  </div>\n\n  <div class=\"panel hidden\" id=\"dashboard-panel\">\n    <h2>Dashboard</h2>\n    <button id=\"checkout-button\">Checkout</button>\n    <div id=\"checkout-result\" class=\"success\" role=\"status\"></div>\n\n    <h3>Search</h3>\n    <input id=\"search-input\" placeholder=\"Search product\" />\n    <div id=\"search-result\"></div>\n  </div>\n\n  <script>\n    const VALID_USER = 'user@example.com';\n    const VALID_PASSWORD = 'password123';\n    const loginForm = document.getElementById('login-form');\n    const message = document.getElementById('login-message');\n    const dashboard = document.getElementById('dashboard-panel');\n    const loginPanel = document.getElementById('login-panel');\n    const checkoutResult = document.getElementById('checkout-result');\n    const searchResult = document.getElementById('search-result');\n\n    loginForm.addEventListener('submit', (event) => {\n      event.preventDefault();\n      const username = document.getElementById('username').value.trim();\n      const password = document.getElementById('password').value.trim();\n\n      if (username === VALID_USER && password === VALID_PASSWORD) {\n        message.textContent = 'Login successful';\n        message.className = 'success';\n        loginPanel.classList.add('hidden');\n        dashboard.classList.remove('hidden');\n        checkoutResult.textContent = '';\n        searchResult.textContent = '';\n      } else {\n        message.textContent = 'Invalid credentials';\n        message.className = 'error';\n      }\n    });\n\n    document.getElementById('checkout-button').addEventListener('click', () => {\n      checkoutResult.textContent = 'Checkout completed successfully.';\n    });\n\n    document.getElementById('search-input').addEventListener('input', (event) => {\n      const value = event.target.value.toLowerCase();\n      if (!value) {\n        searchResult.textContent = '';\n        return;\n      }\n      if (value.includes('apple')) {\n        searchResult.textContent = 'Found 1 product: Apple AirPods';\n      } else {\n        searchResult.textContent = 'No products found.';\n      }\n    });\n  </script>\n</body>\n</html>\n","responseHeaders":{"content-type":"text/html","last-modified":"Sun, 24 May 2026 06:37:58 GMT"},"contentType":"text/html","responseSize":0,"requestBodyTruncated":false,"responseBodyTruncated":false,"isBinary":false,"error":null}
